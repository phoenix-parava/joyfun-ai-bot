# -------------------------------------------------------------
# Joy Bot - Cloud Environment Variables
# -------------------------------------------------------------

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Owner's Telegram User ID (Automatic VIP, bypasses all limits)
OWNER_ID=8747280850

# Web server port for cloud hosting (Render/Koyeb default: 8080)
PORT=8080

# Daily free limits for freemium users
DAILY_FREE_VOICE_LIMIT=10
DAILY_FREE_TEXT_LIMIT=50
